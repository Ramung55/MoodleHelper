# Copy to .env.production on the VM (Git- and Docker-context-ignored), chmod 600.
# The VM's exact tailnet name: no scheme, port or trailing dot. Never commit the real one.
MOODLE_HELPER_TAILNET_HOST=example-vm.example-tailnet.ts.net
# Optional, empty = AI off. Needs MOODLE_HELPER_AI_PROVIDER=groq and
# MOODLE_HELPER_AI_LEDGER_PATH=/data/ai-ledger.sqlite3 to take effect.
GROQ_API_KEY=
