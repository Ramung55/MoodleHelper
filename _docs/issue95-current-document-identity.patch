+import { describe, expect, test } from 'bun:test';
+import { currentDocumentMoodleUserId } from './current-document-identity';
+
+function doc(...scripts: string[]): Document {
+  return { querySelectorAll: () => scripts.map(textContent => ({ textContent })) } as unknown as Document;
+}
+
+describe('current document account evidence', () => {
+  test('accepts a single canonical observed Moodle id', () => {
+    expect(currentDocumentMoodleUserId(doc('M.cfg = {"other":true,"userId":123,"other2":false};'))).toBe('123');
+  });
+  test('rejects absent, guest, malformed and duplicate evidence', () => {
+    for (const source of ['', 'M.cfg={"userId":0}', 'M.cfg={"userId":-1}', 'M.cfg={"userId":01}',
+      'M.cfg={"userId":123,"userId":123}', 'M.cfg={"userId":123,"userId":"123"}',
+      'M.cfg={"userId":123}; M.cfg={"userId":456}']) {
+      expect(currentDocumentMoodleUserId(doc(source))).toBeUndefined();
+    }
+  });
+  test('does not accept unrelated userId text', () => {
+    expect(currentDocumentMoodleUserId(doc('const data = {"userId":123};'))).toBeUndefined();
+  });
+});
