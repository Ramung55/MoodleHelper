# Copy to .env.dev in the dev clone on the VM (Git- and Docker-context-ignored), chmod 600.
# Same tailnet name as production; docker-compose.dev.yaml adds port 8443 and forces demo data.
# The release tag lives in .env.release, written by scripts/deploy.sh <sha> dev.
MOODLE_HELPER_TAILNET_HOST=example-vm.example-tailnet.ts.net
