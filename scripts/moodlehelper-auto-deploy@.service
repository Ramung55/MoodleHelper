# Auto-deploy tick (#148) for one target: moodlehelper-auto-deploy@dev or @production.
# Install: _docs/oracle-deployment.md section 6. Both instances run the production clone's script;
# @dev deploys the sibling clone ~/MoodleHelper-dev. User and path assume user ubuntu (in the
# docker group) and the clone ~/MoodleHelper; edit both if not.
[Unit]
Description=MoodleHelper auto-deploy tick (%i)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
ExecStart=/bin/bash /home/ubuntu/MoodleHelper/scripts/auto-deploy.sh %i
