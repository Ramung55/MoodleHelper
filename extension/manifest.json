{
  "manifest_version": 3,
  "name": "Moodle Helper",
  "version": "0.0.0",
  "background": {
    "service_worker": "index.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://moodle.sdu.edu.kz/*"
      ],
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "http://127.0.0.1:5173/*",
        "http://localhost:5173/*",
        "https://ramung55.github.io/MoodleHelper/*"
      ],
      "js": [
        "dashboard-relay.js"
      ]
    }
  ],
  "minimum_chrome_version": "109",
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://moodle.sdu.edu.kz/*"
  ],
  "permissions": [
    "alarms",
    "downloads",
    "notifications",
    "offscreen"
  ],
  "icons": {
    "128": "icon-128.png"
  }
}
